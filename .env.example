# Supabase
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."  # JWT anon public key from Supabase Dashboard
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Optional: only needed if you also use the new "publishable" key
VITE_SUPABASE_PUBLISHABLE_KEY=""

# App
DOMAIN_NAME="https://your-app.com"

# Google Trends (SerpApi) — Supabase Edge Function secret ONLY.
# Do not add SERPAPI_KEY to Vite/client env. Set it with:
#   supabase secrets set SERPAPI_KEY=your_key
# Local functions: supabase secrets set --local SERPAPI_KEY=your_key
# This project already uses SERPAPI_KEY for flights-search / flight-status.
